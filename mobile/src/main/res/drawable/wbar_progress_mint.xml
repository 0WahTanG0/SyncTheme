<!-- Сгенерировано scripts/gen_widgets.py — не редактировать вручную. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="#FFE3DFD8" />
            <stroke android:width="1dp" android:color="#FFD2CCC3" />
            <corners android:radius="99dp" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip android:clipOrientation="horizontal">
            <shape android:shape="rectangle">
                <gradient android:angle="0" android:startColor="#FFA8DCC3" android:centerColor="#FFB4E2CC" android:endColor="#FFA8DCC3" />
                <stroke android:width="1dp" android:color="#FF7FBB9F" />
                <corners android:radius="99dp" />
            </shape>
        </clip>
    </item>
</layer-list>
