<?xml version="1.0" encoding="utf-8"?>
<!-- Сгенерировано scripts/gen_widgets.py — не редактировать вручную. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="#FF1C1C24" />
            <stroke android:width="1dp" android:color="#33FFFFFF" />
            <corners android:radius="99dp" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip android:clipOrientation="horizontal">
            <shape android:shape="rectangle">
                <gradient android:angle="0" android:startColor="#FF7038E8" android:centerColor="#FFBA58FF" android:endColor="#FFF678E8" />
                <stroke android:width="1dp" android:color="#80FFD6FF" />
                <corners android:radius="99dp" />
            </shape>
        </clip>
    </item>
</layer-list>
