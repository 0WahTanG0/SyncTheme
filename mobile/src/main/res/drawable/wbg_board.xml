<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#FF1E1E22" android:endColor="#FF141417" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="#FF2E2E34" />
        </shape>
    </item>
    <item android:gravity="top|left" android:width="4dp" android:height="4dp" android:left="7dp" android:top="7dp">
        <shape android:shape="oval"><solid android:color="#FF3A3A40" /></shape>
    </item>
    <item android:gravity="top|right" android:width="4dp" android:height="4dp" android:right="7dp" android:top="7dp">
        <shape android:shape="oval"><solid android:color="#FF3A3A40" /></shape>
    </item>
    <item android:gravity="bottom|left" android:width="4dp" android:height="4dp" android:left="7dp" android:bottom="7dp">
        <shape android:shape="oval"><solid android:color="#FF3A3A40" /></shape>
    </item>
    <item android:gravity="bottom|right" android:width="4dp" android:height="4dp" android:right="7dp" android:bottom="7dp">
        <shape android:shape="oval"><solid android:color="#FF3A3A40" /></shape>
    </item>
</layer-list>
