<?xml version="1.0" encoding="utf-8"?>
<!-- Сгенерировано scripts/gen_widgets.py — не редактировать вручную. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="#40FFFFFF" />
            <stroke android:width="1dp" android:color="#D9FFFFFF" />
            <corners android:radius="99dp" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip android:clipOrientation="vertical" android:gravity="bottom">
            <shape android:shape="rectangle">
                <gradient android:angle="90" android:startColor="#E65B8DEF" android:centerColor="#E67AA6F5" android:endColor="#F2A9C6FF" />
                <stroke android:width="1dp" android:color="#B3FFFFFF" />
                <corners android:radius="99dp" />
            </shape>
        </clip>
    </item>
</layer-list>
