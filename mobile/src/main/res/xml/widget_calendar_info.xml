<?xml version="1.0" encoding="utf-8"?>
<!-- Разметка подбирается под размер (RemoteViews по размерам): от 1×1 до 4×4. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:configure="app.synctheme.mobile.widget.WidgetConfigActivity"
    android:description="@string/widget_calendar_desc"
    android:initialLayout="@layout/w_cal_paper_m"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:minResizeWidth="40dp"
    android:minResizeHeight="40dp"
    android:previewLayout="@layout/w_cal_paper_m"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen|keyguard"
    android:widgetFeatures="reconfigurable" />
