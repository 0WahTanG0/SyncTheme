<?xml version="1.0" encoding="utf-8"?>
<!-- Сгенерировано scripts/gen_widget_resources.py — не редактировать вручную. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg_round"
        android:tint="#D91B1B24" />

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="horizontal" android:padding="10dp">
        <TextClock
            android:id="@+id/date_weekday"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="12sp"
            android:autoSizeMaxTextSize="40sp"
            android:includeFontPadding="false"
            android:textAllCaps="true"
            android:format12Hour="EEE"
            android:format24Hour="EEE"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#FFFFFFFF"
            android:fontFamily="sans-serif-medium" />
        <TextClock
            android:id="@+id/date_day"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.3"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="14sp"
            android:autoSizeMaxTextSize="80sp"
            android:includeFontPadding="false"
            android:format12Hour="d"
            android:format24Hour="d"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#FFFFFFFF"
            android:fontFamily="sans-serif-light" />
    </LinearLayout>
</FrameLayout>
