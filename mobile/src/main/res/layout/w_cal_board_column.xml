<?xml version="1.0" encoding="utf-8"?>
<!-- Сгенерировано scripts/gen_widgets.py — не редактировать вручную. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/bg_g"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/wbg_board"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:id="@+id/box_v"
        android:paddingHorizontal="5dp"
        android:paddingVertical="12dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextClock
            android:id="@+id/a_weekday"
            android:layout_width="match_parent"
            android:layout_height="14sp"
            android:gravity="center"
            android:format12Hour="EEE"
            android:format24Hour="EEE"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="6sp"
            android:autoSizeMaxTextSize="10sp"
            android:autoSizeStepGranularity="1sp"
            android:includeFontPadding="false"
            android:textAllCaps="true"
            android:letterSpacing="0.06"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#FFFFFFFF" />

        <FrameLayout
            android:layout_height="wrap_content"
            android:layout_width="match_parent">

            <ImageView
                android:id="@+id/tile_day"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:src="@drawable/wtile"
                android:importantForAccessibility="no" />

            <TextClock
                android:id="@+id/m_day"
                android:textSize="28dp"
                android:includeFontPadding="false"
                android:layout_marginTop="6dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:format12Hour="d"
                android:format24Hour="d"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:maxLines="1"
                android:textColor="#FFFFFFFF" />
        </FrameLayout>

        <TextClock
            android:id="@+id/s_month"
            android:layout_width="match_parent"
            android:layout_height="14sp"
            android:gravity="center"
            android:format12Hour="LLL"
            android:format24Hour="LLL"
            android:fontFamily="monospace"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="6sp"
            android:autoSizeMaxTextSize="10sp"
            android:autoSizeStepGranularity="1sp"
            android:includeFontPadding="false"
            android:textAllCaps="true"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#FFFFFFFF" />

        <ImageView
            android:id="@+id/if_line"
            android:layout_marginVertical="10dp"
            android:layout_width="20dp"
            android:layout_height="1dp"
            android:scaleType="fitXY"
            android:src="@drawable/wline"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:id="@+id/row_ev0"
            android:layout_height="wrap_content"
            android:layout_marginVertical="3dp"
            android:layout_width="match_parent"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:id="@+id/ed_0"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/wdot"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/s_ev0_time"
                android:layout_marginTop="2dp"
                android:layout_width="match_parent"
                android:layout_height="12sp"
                android:gravity="center"
                android:fontFamily="monospace"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="6sp"
                android:autoSizeMaxTextSize="9sp"
                android:autoSizeStepGranularity="1sp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="#FFFFFFFF" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/row_ev1"
            android:layout_height="wrap_content"
            android:layout_marginVertical="3dp"
            android:layout_width="match_parent"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:id="@+id/ed_1"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/wdot"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/s_ev1_time"
                android:layout_marginTop="2dp"
                android:layout_width="match_parent"
                android:layout_height="12sp"
                android:gravity="center"
                android:fontFamily="monospace"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="6sp"
                android:autoSizeMaxTextSize="9sp"
                android:autoSizeStepGranularity="1sp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="#FFFFFFFF" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/row_ev2"
            android:layout_height="wrap_content"
            android:layout_marginVertical="3dp"
            android:layout_width="match_parent"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:id="@+id/ed_2"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/wdot"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/s_ev2_time"
                android:layout_marginTop="2dp"
                android:layout_width="match_parent"
                android:layout_height="12sp"
                android:gravity="center"
                android:fontFamily="monospace"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="6sp"
                android:autoSizeMaxTextSize="9sp"
                android:autoSizeStepGranularity="1sp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="#FFFFFFFF" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>
</FrameLayout>
