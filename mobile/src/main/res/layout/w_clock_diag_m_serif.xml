<?xml version="1.0" encoding="utf-8"?>
<!-- Сгенерировано scripts/gen_widgets.py — не редактировать вручную. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/sc_sky28"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/wsc_day_r28"
        android:importantForAccessibility="no" />

    <ImageView
        android:id="@+id/bg_s"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/wbg_r28"
        android:importantForAccessibility="no"
        android:tint="#E61B1B24" />

    <LinearLayout
        android:padding="14dp"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center">

        <FrameLayout
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:layout_width="match_parent">

            <TextClock
                android:id="@+id/m_hours"
                android:layout_marginTop="-26dp"
                android:layout_marginBottom="-20dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="start"
                android:format12Hour="hh"
                android:format24Hour="HH"
                android:fontFamily="@font/dm_serif"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="16sp"
                android:autoSizeMaxTextSize="500sp"
                android:autoSizeStepGranularity="1sp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="#FFFFFFFF" />
        </FrameLayout>

        <FrameLayout
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:layout_width="match_parent">

            <TextClock
                android:id="@+id/a_minutes"
                android:layout_marginTop="-26dp"
                android:layout_marginBottom="-20dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="end"
                android:format12Hour="mm"
                android:format24Hour="mm"
                android:fontFamily="@font/dm_serif"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="16sp"
                android:autoSizeMaxTextSize="500sp"
                android:autoSizeStepGranularity="1sp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="#FFFFFFFF" />
        </FrameLayout>
    </LinearLayout>

    <TextClock
        android:id="@+id/a_weekday"
        android:layout_gravity="top|end"
        android:layout_margin="12dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:format12Hour="EEEE"
        android:format24Hour="EEEE"
        android:fontFamily="@font/onest_600"
        android:textSize="11sp"
        android:textAllCaps="true"
        android:letterSpacing="0.08"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="#FFFFFFFF" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="14dp"
        android:gravity="start"
        android:orientation="vertical">

        <TextClock
            android:id="@+id/s_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="start"
            android:format12Hour="d MMMM"
            android:format24Hour="d MMMM"
            android:fontFamily="@font/onest_500"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#FFFFFFFF" />
    </LinearLayout>
</FrameLayout>
