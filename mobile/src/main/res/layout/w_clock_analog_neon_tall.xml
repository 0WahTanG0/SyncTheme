<?xml version="1.0" encoding="utf-8"?>
<!-- Сгенерировано scripts/gen_widgets.py — не редактировать вручную. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/bg_s"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/wbg_r24"
        android:importantForAccessibility="no"
        android:tint="#E61B1B24" />

    <ImageView
        android:id="@+id/fx_g"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/wfx_neon"
        android:importantForAccessibility="no"
        android:tint="#FF8B6CF6" />

    <LinearLayout
        android:padding="12dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center">

        <AnalogClock
            android:id="@+id/analog"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:dial="@drawable/dial_neon"
            android:hand_hour="@drawable/analog_hour"
            android:hand_minute="@drawable/analog_minute"
            android:hand_second="@drawable/analog_second"
            android:layout_width="match_parent" />

        <TextClock
            android:id="@+id/m_date"
            android:layout_marginTop="8dp"
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:gravity="center"
            android:format12Hour="EEE, d MMMM"
            android:format24Hour="EEE, d MMMM"
            android:fontFamily="@font/onest_500"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="10sp"
            android:autoSizeMaxTextSize="16sp"
            android:autoSizeStepGranularity="1sp"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#FFFFFFFF" />

        <LinearLayout
            android:id="@+id/row_alarm"
            android:layout_width="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/is_alarm"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:scaleType="fitCenter"
                android:src="@drawable/wic_alarm"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/s_alarm"
                android:layout_marginStart="5dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="start"
                android:fontFamily="@font/onest_500"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="#FFFFFFFF" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
