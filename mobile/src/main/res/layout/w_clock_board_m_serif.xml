<?xml version="1.0" encoding="utf-8"?>
<!-- Сгенерировано scripts/gen_widgets.py — не редактировать вручную. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/bg_g"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/wbg_board"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:padding="12dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center">

        <LinearLayout
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_width="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/tile_hours"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitXY"
                    android:src="@drawable/wtile"
                    android:importantForAccessibility="no" />

                <TextClock
                    android:id="@+id/m_hours"
                    android:paddingHorizontal="5dp"
                    android:paddingVertical="3dp"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:format12Hour="hh"
                    android:format24Hour="HH"
                    android:fontFamily="@font/dm_serif"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="16sp"
                    android:autoSizeMaxTextSize="300sp"
                    android:autoSizeStepGranularity="1sp"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="#FFFFFFFF" />

                <ImageView
                    android:id="@+id/tih_m_hours"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingHorizontal="5dp"
                    android:paddingVertical="3dp"
                    android:scaleType="fitCenter"
                    android:visibility="gone"
                    android:importantForAccessibility="no" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="5dp">

                <ImageView
                    android:id="@+id/tile_minutes"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitXY"
                    android:src="@drawable/wtile"
                    android:importantForAccessibility="no" />

                <TextClock
                    android:id="@+id/m_minutes"
                    android:paddingHorizontal="5dp"
                    android:paddingVertical="3dp"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:format12Hour="mm"
                    android:format24Hour="mm"
                    android:fontFamily="@font/dm_serif"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="16sp"
                    android:autoSizeMaxTextSize="300sp"
                    android:autoSizeStepGranularity="1sp"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="#FFFFFFFF" />

                <ImageView
                    android:id="@+id/tim_m_minutes"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingHorizontal="5dp"
                    android:paddingVertical="3dp"
                    android:scaleType="fitCenter"
                    android:visibility="gone"
                    android:importantForAccessibility="no" />
            </FrameLayout>
        </LinearLayout>

        <TextClock
            android:id="@+id/a_date"
            android:layout_marginTop="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:format12Hour="EEE d MMM"
            android:format24Hour="EEE d MMM"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:textSize="12sp"
            android:textAllCaps="true"
            android:letterSpacing="0.08"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#FFFFFFFF" />
    </LinearLayout>
</FrameLayout>
