<?xml version="1.0" encoding="utf-8"?>
<!-- Сгенерировано scripts/gen_widgets.py — не редактировать вручную. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/bg_s"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/wbg_r18"
        android:importantForAccessibility="no"
        android:tint="#E61B1B24" />

    <AnalogClock
        android:id="@+id/analog"
        android:layout_margin="8dp"
        android:dial="@drawable/dial_minimal"
        android:hand_hour="@drawable/hand_hour_thin"
        android:hand_minute="@drawable/hand_minute_thin"
        android:hand_second="@drawable/analog_second"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</FrameLayout>
