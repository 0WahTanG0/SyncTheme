<?xml version="1.0" encoding="utf-8"?>
<!-- Сгенерировано scripts/gen_widgets.py — не редактировать вручную. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/bg_s"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/wbg_r24"
        android:importantForAccessibility="no"
        android:tint="#E61B1B24" />

    <ImageView
        android:id="@+id/fx_g"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/wfx_neon"
        android:importantForAccessibility="no"
        android:tint="#FF8B6CF6" />

    <LinearLayout
        android:padding="4dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center">

        <TextClock
            android:id="@+id/a_weekday"
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:gravity="center"
            android:format12Hour="EEE"
            android:format24Hour="EEE"
            android:fontFamily="@font/unbounded_500"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="7sp"
            android:autoSizeMaxTextSize="14sp"
            android:autoSizeStepGranularity="1sp"
            android:includeFontPadding="false"
            android:textAllCaps="true"
            android:letterSpacing="0.06"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#FFFFFFFF" />

        <TextClock
            android:id="@+id/m_time"
            android:layout_weight="1"
            android:lineSpacingMultiplier="0.63"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:gravity="center"
            android:format12Hour="hh\nmm"
            android:format24Hour="HH\nmm"
            android:fontFamily="@font/bungee_outline"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="12sp"
            android:autoSizeMaxTextSize="400sp"
            android:autoSizeStepGranularity="1sp"
            android:includeFontPadding="false"
            android:maxLines="2"
            android:ellipsize="end"
            android:shadowColor="#80FFFFFF"
            android:shadowRadius="14"
            android:shadowDx="0"
            android:shadowDy="0"
            android:textColor="#FFFFFFFF" />

        <TextClock
            android:id="@+id/s_date"
            android:layout_width="match_parent"
            android:layout_height="18dp"
            android:gravity="center"
            android:format12Hour="d MMM"
            android:format24Hour="d MMM"
            android:fontFamily="@font/onest_500"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="7sp"
            android:autoSizeMaxTextSize="13sp"
            android:autoSizeStepGranularity="1sp"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#FFFFFFFF" />
    </LinearLayout>
</FrameLayout>
