<?xml version="1.0" encoding="utf-8"?>
<!-- Сгенерировано scripts/gen_widgets.py — не редактировать вручную. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/bg_s"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/wbg_r36"
        android:importantForAccessibility="no"
        android:tint="#E61B1B24" />

    <LinearLayout
        android:layout_height="match_parent"
        android:paddingHorizontal="14dp"
        android:paddingVertical="8dp"
        android:layout_width="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <FrameLayout
            android:layout_width="56dp"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/sh_a"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:src="@drawable/wsh_cookie"
                android:importantForAccessibility="no"
                android:tint="#FF8B6CF6" />

            <TextClock
                android:id="@+id/o_day"
                android:padding="6dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:format12Hour="d"
                android:format24Hour="d"
                android:fontFamily="@font/nunito_900"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="10sp"
                android:autoSizeMaxTextSize="60sp"
                android:autoSizeStepGranularity="1sp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="#FFFFFFFF" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical|start"
            android:layout_marginStart="12dp"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <TextClock
                android:id="@+id/a_weekday"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="start"
                android:format12Hour="EEEE, LLLL"
                android:format24Hour="EEEE, LLLL"
                android:fontFamily="@font/nunito_900"
                android:textSize="12sp"
                android:textAllCaps="true"
                android:letterSpacing="0.05"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="#FFFFFFFF" />

            <TextView
                android:id="@+id/m_ev0_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="start"
                android:fontFamily="@font/nunito_700"
                android:textSize="15sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="#FFFFFFFF" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
