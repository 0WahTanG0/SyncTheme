<?xml version="1.0" encoding="utf-8"?>
<!-- Сгенерировано scripts/gen_widgets.py — не редактировать вручную. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/bg_s"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/wbg_r36"
        android:importantForAccessibility="no"
        android:tint="#E61B1B24" />

    <LinearLayout
        android:padding="14dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center">

        <FrameLayout
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_width="match_parent">

            <ImageView
                android:id="@+id/sh_a"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:src="@drawable/wsh_scallop"
                android:importantForAccessibility="no"
                android:tint="#FF8B6CF6" />

            <LinearLayout
                android:padding="10dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center">

                <TextClock
                    android:id="@+id/n_weekday"
                    android:layout_width="match_parent"
                    android:layout_height="20dp"
                    android:gravity="center"
                    android:format12Hour="EEE"
                    android:format24Hour="EEE"
                    android:fontFamily="@font/nunito_900"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="8sp"
                    android:autoSizeMaxTextSize="14sp"
                    android:autoSizeStepGranularity="1sp"
                    android:includeFontPadding="false"
                    android:textAllCaps="true"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="#FFFFFFFF" />

                <TextClock
                    android:id="@+id/o_day"
                    android:layout_weight="1"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:gravity="center"
                    android:format12Hour="d"
                    android:format24Hour="d"
                    android:fontFamily="@font/nunito_900"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="14sp"
                    android:autoSizeMaxTextSize="90sp"
                    android:autoSizeStepGranularity="1sp"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="#FFFFFFFF" />
            </LinearLayout>
        </FrameLayout>

        <TextClock
            android:id="@+id/s_month"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:format12Hour="LLLL"
            android:format24Hour="LLLL"
            android:fontFamily="@font/nunito_700"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#FFFFFFFF" />

        <TextView
            android:id="@+id/m_ev0_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:fontFamily="@font/nunito_700"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#FFFFFFFF" />
    </LinearLayout>
</FrameLayout>
