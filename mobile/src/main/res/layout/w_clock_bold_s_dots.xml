<?xml version="1.0" encoding="utf-8"?>
<!-- Сгенерировано scripts/gen_widgets.py — не редактировать вручную. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/sc_sky28"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/wsc_day_r28"
        android:importantForAccessibility="no" />

    <ImageView
        android:id="@+id/bg_s"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/wbg_r28"
        android:importantForAccessibility="no"
        android:tint="#E61B1B24" />

    <LinearLayout
        android:id="@+id/box_al"
        android:padding="8dp"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center">

        <FrameLayout
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:layout_width="match_parent">

            <TextClock
                android:id="@+id/m_hours_al"
                android:layout_marginTop="-12dp"
                android:layout_marginBottom="-13dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:format12Hour="hh"
                android:format24Hour="HH"
                android:fontFamily="@font/doto"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="16sp"
                android:autoSizeMaxTextSize="300sp"
                android:autoSizeStepGranularity="1sp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="#FFFFFFFF" />

            <ImageView
                android:id="@+id/tih_m_hours_al_s"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="-12dp"
                android:layout_marginBottom="-13dp"
                android:scaleType="fitStart"
                android:visibility="gone"
                android:importantForAccessibility="no" />

            <ImageView
                android:id="@+id/tih_m_hours_al_c"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="-12dp"
                android:layout_marginBottom="-13dp"
                android:scaleType="fitCenter"
                android:visibility="gone"
                android:importantForAccessibility="no" />

            <ImageView
                android:id="@+id/tih_m_hours_al_e"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="-12dp"
                android:layout_marginBottom="-13dp"
                android:scaleType="fitEnd"
                android:visibility="gone"
                android:importantForAccessibility="no" />
        </FrameLayout>

        <FrameLayout
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:layout_width="match_parent">

            <TextClock
                android:id="@+id/a_minutes_al"
                android:layout_marginTop="-12dp"
                android:layout_marginBottom="-13dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:format12Hour="mm"
                android:format24Hour="mm"
                android:fontFamily="@font/doto"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="16sp"
                android:autoSizeMaxTextSize="300sp"
                android:autoSizeStepGranularity="1sp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="#FFFFFFFF" />

            <ImageView
                android:id="@+id/tim_a_minutes_al_s"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="-12dp"
                android:layout_marginBottom="-13dp"
                android:scaleType="fitStart"
                android:visibility="gone"
                android:importantForAccessibility="no" />

            <ImageView
                android:id="@+id/tim_a_minutes_al_c"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="-12dp"
                android:layout_marginBottom="-13dp"
                android:scaleType="fitCenter"
                android:visibility="gone"
                android:importantForAccessibility="no" />

            <ImageView
                android:id="@+id/tim_a_minutes_al_e"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="-12dp"
                android:layout_marginBottom="-13dp"
                android:scaleType="fitEnd"
                android:visibility="gone"
                android:importantForAccessibility="no" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
