<?xml version="1.0" encoding="utf-8"?>
<!-- Сгенерировано scripts/gen_widgets.py — не редактировать вручную. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/bg_s"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/wbg_r24"
        android:importantForAccessibility="no"
        android:tint="#E61B1B24" />

    <ImageView
        android:id="@+id/fx_g"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/wfx_neon"
        android:importantForAccessibility="no"
        android:tint="#FF8B6CF6" />

    <LinearLayout
        android:layout_height="match_parent"
        android:paddingHorizontal="18dp"
        android:paddingVertical="8dp"
        android:layout_width="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextClock
            android:id="@+id/m_time"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:gravity="center_vertical|start"
            android:format12Hour="h:mm"
            android:format24Hour="H:mm"
            android:fontFamily="@font/oswald_700"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="16sp"
            android:autoSizeMaxTextSize="120sp"
            android:autoSizeStepGranularity="1sp"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end"
            android:shadowColor="#80FFFFFF"
            android:shadowRadius="14"
            android:shadowDx="0"
            android:shadowDy="0"
            android:textColor="#FFFFFFFF" />

        <TextClock
            android:id="@+id/a_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end|center_vertical"
            android:format12Hour="EEE, d MMM"
            android:format24Hour="EEE, d MMM"
            android:fontFamily="@font/unbounded_500"
            android:textSize="12sp"
            android:textAllCaps="true"
            android:letterSpacing="0.06"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#FFFFFFFF" />
    </LinearLayout>
</FrameLayout>
