<?xml version="1.0" encoding="utf-8"?>
<!-- Сгенерировано scripts/gen_widgets.py — не редактировать вручную. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/sc_sky18"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/wsc_day_r18"
        android:importantForAccessibility="no" />

    <ImageView
        android:id="@+id/bg_s"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/wbg_r18"
        android:importantForAccessibility="no"
        android:tint="#E61B1B24" />

    <LinearLayout
        android:id="@+id/box_v"
        android:paddingHorizontal="12dp"
        android:paddingVertical="16dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextClock
            android:id="@+id/a_weekday"
            android:layout_width="match_parent"
            android:layout_height="17sp"
            android:gravity="center"
            android:format12Hour="EEEE"
            android:format24Hour="EEEE"
            android:fontFamily="monospace"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="6sp"
            android:autoSizeMaxTextSize="12sp"
            android:autoSizeStepGranularity="1sp"
            android:includeFontPadding="false"
            android:textAllCaps="true"
            android:letterSpacing="0.06"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#FFFFFFFF" />

        <TextClock
            android:id="@+id/m_hours"
            android:textSize="52dp"
            android:includeFontPadding="false"
            android:layout_marginTop="6dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:format12Hour="hh"
            android:format24Hour="HH"
            android:fontFamily="@font/oswald_700"
            android:maxLines="1"
            android:textColor="#FFFFFFFF" />

        <ImageView
            android:id="@+id/tih_m_hours"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:scaleType="fitCenter"
            android:visibility="gone"
            android:importantForAccessibility="no" />

        <TextClock
            android:id="@+id/m_minutes"
            android:textSize="52dp"
            android:includeFontPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:format12Hour="mm"
            android:format24Hour="mm"
            android:fontFamily="@font/oswald_700"
            android:maxLines="1"
            android:textColor="#FFFFFFFF" />

        <ImageView
            android:id="@+id/tim_m_minutes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scaleType="fitCenter"
            android:visibility="gone"
            android:importantForAccessibility="no" />

        <ImageView
            android:id="@+id/if_line"
            android:layout_marginVertical="10dp"
            android:layout_width="40dp"
            android:layout_height="1dp"
            android:scaleType="fitXY"
            android:src="@drawable/wline"
            android:importantForAccessibility="no" />

        <TextClock
            android:id="@+id/s_date"
            android:layout_width="match_parent"
            android:layout_height="17sp"
            android:gravity="center"
            android:format12Hour="d MMMM"
            android:format24Hour="d MMMM"
            android:fontFamily="sans-serif-light"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="6sp"
            android:autoSizeMaxTextSize="12sp"
            android:autoSizeStepGranularity="1sp"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#FFFFFFFF" />

        <LinearLayout
            android:id="@+id/row_alarm"
            android:layout_width="wrap_content"
            android:layout_height="16sp"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/is_alarm"
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:scaleType="fitCenter"
                android:src="@drawable/wic_alarm"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/s_alarm"
                android:layout_marginStart="3dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="start"
                android:fontFamily="sans-serif-light"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="#FFFFFFFF" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>
</FrameLayout>
