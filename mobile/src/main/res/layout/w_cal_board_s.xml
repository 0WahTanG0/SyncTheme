<?xml version="1.0" encoding="utf-8"?>
<!-- Сгенерировано scripts/gen_widgets.py — не редактировать вручную. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/bg_g"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/wbg_board"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:padding="8dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center">

        <TextClock
            android:id="@+id/a_weekday_al"
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:gravity="center"
            android:format12Hour="EEE"
            android:format24Hour="EEE"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="8sp"
            android:autoSizeMaxTextSize="16sp"
            android:autoSizeStepGranularity="1sp"
            android:includeFontPadding="false"
            android:textAllCaps="true"
            android:letterSpacing="0.08"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#FFFFFFFF" />

        <FrameLayout
            android:layout_weight="1"
            android:layout_width="match_parent"
            android:layout_height="0dp">

            <ImageView
                android:id="@+id/tile_day"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:src="@drawable/wtile"
                android:importantForAccessibility="no" />

            <TextClock
                android:id="@+id/m_day_al"
                android:gravity="center"
                android:format12Hour="d"
                android:format24Hour="d"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="16sp"
                android:autoSizeMaxTextSize="300sp"
                android:autoSizeStepGranularity="1sp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="#FFFFFFFF"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="4dp" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
