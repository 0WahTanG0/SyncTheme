<?xml version="1.0" encoding="utf-8"?>
<!-- Сгенерировано scripts/gen_widget_resources.py — не редактировать вручную. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg_round"
        android:tint="#D91B1B24" />

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal" android:padding="12dp">
        <TextClock
            android:id="@+id/clock_time"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.5"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="18sp"
            android:autoSizeMaxTextSize="120sp"
            android:includeFontPadding="false"
            android:format12Hour="h:mm"
            android:format24Hour="HH:mm"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#FFFFFFFF"
            android:fontFamily="sans-serif" />
        <ImageView
            android:id="@+id/clock_divider"
            android:layout_width="3dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="12dp"
            android:layout_marginVertical="14dp"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/dot" />
        
    <LinearLayout
        android:id="@+id/side_text"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_vertical|start"
        android:orientation="vertical"
        android:padding="0dp">
        <TextClock
            android:id="@+id/clock_weekday"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textAllCaps="true"
            android:format12Hour="EEEE"
            android:format24Hour="EEEE"
            android:gravity="start"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#FFFFFFFF"
            android:fontFamily="sans-serif-medium" />
        <TextClock
            android:id="@+id/clock_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:format12Hour="d MMMM"
            android:format24Hour="d MMMM"
            android:gravity="start"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#FFFFFFFF" />
    </LinearLayout>
    </LinearLayout>
</FrameLayout>
