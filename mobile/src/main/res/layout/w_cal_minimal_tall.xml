<?xml version="1.0" encoding="utf-8"?>
<!-- Сгенерировано scripts/gen_widgets.py — не редактировать вручную. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/bg_s"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/wbg_r18"
        android:importantForAccessibility="no"
        android:tint="#E61B1B24" />

    <LinearLayout
        android:id="@+id/box_v"
        android:paddingHorizontal="12dp"
        android:paddingVertical="16dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextClock
            android:id="@+id/a_weekday"
            android:layout_width="match_parent"
            android:layout_height="17sp"
            android:gravity="center"
            android:format12Hour="EEEE"
            android:format24Hour="EEEE"
            android:fontFamily="monospace"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="6sp"
            android:autoSizeMaxTextSize="12sp"
            android:autoSizeStepGranularity="1sp"
            android:includeFontPadding="false"
            android:textAllCaps="true"
            android:letterSpacing="0.06"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#FFFFFFFF" />

        <TextClock
            android:id="@+id/m_day"
            android:textSize="52dp"
            android:includeFontPadding="false"
            android:layout_marginTop="6dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:format12Hour="d"
            android:format24Hour="d"
            android:fontFamily="sans-serif-thin"
            android:maxLines="1"
            android:textColor="#FFFFFFFF" />

        <TextClock
            android:id="@+id/s_month"
            android:layout_width="match_parent"
            android:layout_height="17sp"
            android:gravity="center"
            android:format12Hour="LLLL"
            android:format24Hour="LLLL"
            android:fontFamily="sans-serif-light"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="6sp"
            android:autoSizeMaxTextSize="12sp"
            android:autoSizeStepGranularity="1sp"
            android:includeFontPadding="false"
            android:textAllCaps="true"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#FFFFFFFF" />

        <ImageView
            android:id="@+id/if_line"
            android:layout_marginVertical="10dp"
            android:layout_width="40dp"
            android:layout_height="1dp"
            android:scaleType="fitXY"
            android:src="@drawable/wline"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:id="@+id/row_ev0"
            android:layout_marginVertical="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/ed_0"
                android:layout_width="3dp"
                android:layout_height="26dp"
                android:scaleType="fitXY"
                android:src="@drawable/wpill"
                android:importantForAccessibility="no" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/m_ev0_title"
                    android:layout_width="match_parent"
                    android:layout_height="16sp"
                    android:gravity="start"
                    android:fontFamily="sans-serif-light"
                    android:textSize="12sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="#FFFFFFFF" />

                <TextView
                    android:id="@+id/s_ev0_time"
                    android:layout_width="match_parent"
                    android:layout_height="14sp"
                    android:gravity="start"
                    android:fontFamily="sans-serif-light"
                    android:textSize="10sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="#FFFFFFFF" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/row_ev1"
            android:layout_marginVertical="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/ed_1"
                android:layout_width="3dp"
                android:layout_height="26dp"
                android:scaleType="fitXY"
                android:src="@drawable/wpill"
                android:importantForAccessibility="no" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/m_ev1_title"
                    android:layout_width="match_parent"
                    android:layout_height="16sp"
                    android:gravity="start"
                    android:fontFamily="sans-serif-light"
                    android:textSize="12sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="#FFFFFFFF" />

                <TextView
                    android:id="@+id/s_ev1_time"
                    android:layout_width="match_parent"
                    android:layout_height="14sp"
                    android:gravity="start"
                    android:fontFamily="sans-serif-light"
                    android:textSize="10sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="#FFFFFFFF" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/row_ev2"
            android:layout_marginVertical="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/ed_2"
                android:layout_width="3dp"
                android:layout_height="26dp"
                android:scaleType="fitXY"
                android:src="@drawable/wpill"
                android:importantForAccessibility="no" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/m_ev2_title"
                    android:layout_width="match_parent"
                    android:layout_height="16sp"
                    android:gravity="start"
                    android:fontFamily="sans-serif-light"
                    android:textSize="12sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="#FFFFFFFF" />

                <TextView
                    android:id="@+id/s_ev2_time"
                    android:layout_width="match_parent"
                    android:layout_height="14sp"
                    android:gravity="start"
                    android:fontFamily="sans-serif-light"
                    android:textSize="10sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="#FFFFFFFF" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/s_ev_empty"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="44sp"
            android:gravity="center"
            android:fontFamily="sans-serif-light"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="7sp"
            android:autoSizeMaxTextSize="11sp"
            android:autoSizeStepGranularity="1sp"
            android:includeFontPadding="false"
            android:maxLines="3"
            android:ellipsize="end"
            android:textColor="#FFFFFFFF"
            android:text="Событий нет" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>
</FrameLayout>
