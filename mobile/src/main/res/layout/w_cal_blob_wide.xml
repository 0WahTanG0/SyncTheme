<?xml version="1.0" encoding="utf-8"?>
<!-- Сгенерировано scripts/gen_widgets.py — не редактировать вручную. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/bg_s"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/wbg_r36"
        android:importantForAccessibility="no"
        android:tint="#E61B1B24" />

    <LinearLayout
        android:layout_height="match_parent"
        android:padding="14dp"
        android:layout_width="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="0.85"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center">

            <TextClock
                android:id="@+id/a_weekday"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:format12Hour="EEEE"
                android:format24Hour="EEEE"
                android:fontFamily="@font/nunito_900"
                android:textSize="13sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="#FFFFFFFF" />

            <FrameLayout
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginVertical="4dp"
                android:layout_width="match_parent">

                <ImageView
                    android:id="@+id/sh_a"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter"
                    android:src="@drawable/wsh_scallop"
                    android:importantForAccessibility="no"
                    android:tint="#FF8B6CF6" />

                <TextClock
                    android:id="@+id/o_day"
                    android:padding="14dp"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:format12Hour="d"
                    android:format24Hour="d"
                    android:fontFamily="@font/nunito_900"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="16sp"
                    android:autoSizeMaxTextSize="90sp"
                    android:autoSizeStepGranularity="1sp"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="#FFFFFFFF" />
            </FrameLayout>

            <TextClock
                android:id="@+id/s_month"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:format12Hour="LLLL"
                android:format24Hour="LLLL"
                android:fontFamily="@font/nunito_700"
                android:textSize="13sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="#FFFFFFFF" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1.4"
            android:gravity="center_vertical"
            android:layout_marginStart="12dp"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/row_ev0"
                android:layout_marginVertical="2dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/ed_0"
                    android:layout_width="3dp"
                    android:layout_height="16dp"
                    android:scaleType="fitXY"
                    android:src="@drawable/wpill"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/m_ev0_title"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:gravity="start"
                    android:fontFamily="@font/nunito_700"
                    android:textSize="13sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="#FFFFFFFF" />

                <TextView
                    android:id="@+id/s_ev0_time"
                    android:layout_marginStart="6dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:fontFamily="@font/nunito_700"
                    android:textSize="11sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="#FFFFFFFF" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/row_ev1"
                android:layout_marginVertical="2dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/ed_1"
                    android:layout_width="3dp"
                    android:layout_height="16dp"
                    android:scaleType="fitXY"
                    android:src="@drawable/wpill"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/m_ev1_title"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:gravity="start"
                    android:fontFamily="@font/nunito_700"
                    android:textSize="13sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="#FFFFFFFF" />

                <TextView
                    android:id="@+id/s_ev1_time"
                    android:layout_marginStart="6dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:fontFamily="@font/nunito_700"
                    android:textSize="11sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="#FFFFFFFF" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/row_ev2"
                android:layout_marginVertical="2dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/ed_2"
                    android:layout_width="3dp"
                    android:layout_height="16dp"
                    android:scaleType="fitXY"
                    android:src="@drawable/wpill"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/m_ev2_title"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:gravity="start"
                    android:fontFamily="@font/nunito_700"
                    android:textSize="13sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="#FFFFFFFF" />

                <TextView
                    android:id="@+id/s_ev2_time"
                    android:layout_marginStart="6dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:fontFamily="@font/nunito_700"
                    android:textSize="11sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="#FFFFFFFF" />
            </LinearLayout>

            <TextView
                android:id="@+id/s_ev_empty"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="start"
                android:fontFamily="@font/nunito_700"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="#FFFFFFFF"
                android:text="Событий нет" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
