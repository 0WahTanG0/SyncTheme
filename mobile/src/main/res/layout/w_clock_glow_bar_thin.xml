<?xml version="1.0" encoding="utf-8"?>
<!-- Сгенерировано scripts/gen_widgets.py — не редактировать вручную. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/bg_g"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/wbg_glow"
        android:importantForAccessibility="no" />

    <ImageView
        android:id="@+id/fx_g"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/wfx_glow"
        android:importantForAccessibility="no"
        android:tint="#FF8B6CF6" />

    <LinearLayout
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center">

        <TextClock
            android:id="@+id/m_time"
            android:layout_weight="1"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:gravity="center"
            android:format12Hour="h:mm"
            android:format24Hour="H:mm"
            android:fontFamily="sans-serif-thin"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="12sp"
            android:autoSizeMaxTextSize="200sp"
            android:autoSizeStepGranularity="1sp"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#FFFFFFFF"
            android:shadowColor="#73FFFFFF"
            android:shadowRadius="18"
            android:shadowDx="0"
            android:shadowDy="0" />

        <TextClock
            android:id="@+id/s_date"
            android:layout_width="match_parent"
            android:layout_height="17dp"
            android:gravity="center"
            android:format12Hour="EEE, d MMM"
            android:format24Hour="EEE, d MMM"
            android:fontFamily="sans-serif-light"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="7sp"
            android:autoSizeMaxTextSize="12sp"
            android:autoSizeStepGranularity="1sp"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#FFFFFFFF" />
    </LinearLayout>
</FrameLayout>
