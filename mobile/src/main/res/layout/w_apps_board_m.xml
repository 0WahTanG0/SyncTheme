<?xml version="1.0" encoding="utf-8"?>
<!-- Сгенерировано scripts/gen_widgets.py — не редактировать вручную. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/bg_g"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/wbg_board"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:id="@+id/m_title"
            android:layout_marginBottom="2dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:textSize="12sp"
            android:textAllCaps="true"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#FFFFFFFF" />

        <LinearLayout
            android:padding="22dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center">

            <LinearLayout
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/cell_ap0"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <FrameLayout
                        android:layout_width="52dp"
                        android:layout_height="52dp">

                        <ImageView
                            android:id="@+id/tile_ap0"
                            android:layout_gravity="center"
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:scaleType="fitXY"
                            android:src="@drawable/wtile_sq"
                            android:importantForAccessibility="no" />

                        <ImageView
                            android:id="@+id/ap_0"
                            android:layout_gravity="center"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/wapp_placeholder"
                            android:importantForAccessibility="no" />
                    </FrameLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/cell_ap1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <FrameLayout
                        android:layout_width="52dp"
                        android:layout_height="52dp">

                        <ImageView
                            android:id="@+id/tile_ap1"
                            android:layout_gravity="center"
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:scaleType="fitXY"
                            android:src="@drawable/wtile_sq"
                            android:importantForAccessibility="no" />

                        <ImageView
                            android:id="@+id/ap_1"
                            android:layout_gravity="center"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/wapp_placeholder"
                            android:importantForAccessibility="no" />
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:gravity="center"
                android:layout_marginTop="6dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/cell_ap2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <FrameLayout
                        android:layout_width="52dp"
                        android:layout_height="52dp">

                        <ImageView
                            android:id="@+id/tile_ap2"
                            android:layout_gravity="center"
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:scaleType="fitXY"
                            android:src="@drawable/wtile_sq"
                            android:importantForAccessibility="no" />

                        <ImageView
                            android:id="@+id/ap_2"
                            android:layout_gravity="center"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/wapp_placeholder"
                            android:importantForAccessibility="no" />
                    </FrameLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/cell_ap3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <FrameLayout
                        android:layout_width="52dp"
                        android:layout_height="52dp">

                        <ImageView
                            android:id="@+id/tile_ap3"
                            android:layout_gravity="center"
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:scaleType="fitXY"
                            android:src="@drawable/wtile_sq"
                            android:importantForAccessibility="no" />

                        <ImageView
                            android:id="@+id/ap_3"
                            android:layout_gravity="center"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/wapp_placeholder"
                            android:importantForAccessibility="no" />
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
