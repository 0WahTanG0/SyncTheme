<?xml version="1.0" encoding="utf-8"?>
<!-- Сгенерировано scripts/gen_widgets.py — не редактировать вручную. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/bg_s"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/wbg_r36"
        android:importantForAccessibility="no"
        android:tint="#E61B1B24" />

    <LinearLayout
        android:padding="4dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center">

        <TextClock
            android:id="@+id/a_weekday"
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:gravity="center"
            android:format12Hour="EEE"
            android:format24Hour="EEE"
            android:fontFamily="@font/nunito_900"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="7sp"
            android:autoSizeMaxTextSize="14sp"
            android:autoSizeStepGranularity="1sp"
            android:includeFontPadding="false"
            android:textAllCaps="true"
            android:letterSpacing="0.06"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#FFFFFFFF" />

        <TextClock
            android:id="@+id/m_day"
            android:layout_weight="1"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:gravity="center"
            android:format12Hour="d"
            android:format24Hour="d"
            android:fontFamily="@font/nunito_900"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="10sp"
            android:autoSizeMaxTextSize="34sp"
            android:autoSizeStepGranularity="1sp"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#FFFFFFFF" />

        <TextClock
            android:id="@+id/s_month"
            android:layout_width="match_parent"
            android:layout_height="18dp"
            android:gravity="center"
            android:format12Hour="LLL"
            android:format24Hour="LLL"
            android:fontFamily="@font/nunito_700"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="7sp"
            android:autoSizeMaxTextSize="13sp"
            android:autoSizeStepGranularity="1sp"
            android:includeFontPadding="false"
            android:textAllCaps="true"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#FFFFFFFF" />

        <ImageView
            android:id="@+id/if_line"
            android:layout_marginVertical="6dp"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:scaleType="fitXY"
            android:src="@drawable/wline"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:id="@+id/row_ev0"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="3dp"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:id="@+id/ed_0"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/wdot"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/s_ev0_time"
                android:layout_marginTop="2dp"
                android:layout_width="match_parent"
                android:layout_height="14dp"
                android:gravity="center"
                android:fontFamily="@font/nunito_700"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="6sp"
                android:autoSizeMaxTextSize="10sp"
                android:autoSizeStepGranularity="1sp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="#FFFFFFFF" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/row_ev1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="3dp"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:id="@+id/ed_1"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/wdot"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/s_ev1_time"
                android:layout_marginTop="2dp"
                android:layout_width="match_parent"
                android:layout_height="14dp"
                android:gravity="center"
                android:fontFamily="@font/nunito_700"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="6sp"
                android:autoSizeMaxTextSize="10sp"
                android:autoSizeStepGranularity="1sp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="#FFFFFFFF" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/row_ev2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="3dp"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:id="@+id/ed_2"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/wdot"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/s_ev2_time"
                android:layout_marginTop="2dp"
                android:layout_width="match_parent"
                android:layout_height="14dp"
                android:gravity="center"
                android:fontFamily="@font/nunito_700"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="6sp"
                android:autoSizeMaxTextSize="10sp"
                android:autoSizeStepGranularity="1sp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="#FFFFFFFF" />
        </LinearLayout>

        <TextView
            android:id="@+id/s_ev_empty"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="14dp"
            android:gravity="center"
            android:fontFamily="@font/nunito_700"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="6sp"
            android:autoSizeMaxTextSize="10sp"
            android:autoSizeStepGranularity="1sp"
            android:includeFontPadding="false"
            android:maxLines="2"
            android:ellipsize="end"
            android:textColor="#FFFFFFFF"
            android:text="Событий нет" />
    </LinearLayout>
</FrameLayout>
