<?xml version="1.0" encoding="utf-8"?>
<!-- Сгенерировано scripts/gen_widgets.py — не редактировать вручную. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/bg_g"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/wbg_glass"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:padding="12dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/wx_now"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:scaleType="fitCenter"
                android:src="@drawable/wx_partly_day"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/m_temp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:gravity="center"
                android:fontFamily="@font/manrope_800"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="16sp"
                android:autoSizeMaxTextSize="44sp"
                android:autoSizeStepGranularity="1sp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="#FFFFFFFF" />
        </LinearLayout>

        <TextView
            android:id="@+id/m_city"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:fontFamily="@font/manrope_600"
            android:textSize="14sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#FFFFFFFF" />

        <TextView
            android:id="@+id/a_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:fontFamily="@font/manrope_600"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#FFFFFFFF" />

        <ImageView
            android:id="@+id/if_line"
            android:layout_marginVertical="8dp"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:scaleType="fitXY"
            android:src="@drawable/wline"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:id="@+id/cell_h0"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_width="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/s_h0_time"
                android:layout_weight="1.2"
                android:layout_width="0dp"
                android:layout_height="17dp"
                android:gravity="start|center_vertical"
                android:fontFamily="@font/manrope_600"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="8sp"
                android:autoSizeMaxTextSize="12sp"
                android:autoSizeStepGranularity="1sp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="#FFFFFFFF" />

            <ImageView
                android:id="@+id/wx_h0"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:scaleType="fitCenter"
                android:src="@drawable/wx_clear_day"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/m_h0_temp"
                android:layout_weight="1"
                android:layout_width="0dp"
                android:layout_height="20dp"
                android:gravity="end|center_vertical"
                android:fontFamily="@font/manrope_600"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="9sp"
                android:autoSizeMaxTextSize="14sp"
                android:autoSizeStepGranularity="1sp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="#FFFFFFFF" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cell_h1"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_width="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/s_h1_time"
                android:layout_weight="1.2"
                android:layout_width="0dp"
                android:layout_height="17dp"
                android:gravity="start|center_vertical"
                android:fontFamily="@font/manrope_600"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="8sp"
                android:autoSizeMaxTextSize="12sp"
                android:autoSizeStepGranularity="1sp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="#FFFFFFFF" />

            <ImageView
                android:id="@+id/wx_h1"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:scaleType="fitCenter"
                android:src="@drawable/wx_clear_day"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/m_h1_temp"
                android:layout_weight="1"
                android:layout_width="0dp"
                android:layout_height="20dp"
                android:gravity="end|center_vertical"
                android:fontFamily="@font/manrope_600"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="9sp"
                android:autoSizeMaxTextSize="14sp"
                android:autoSizeStepGranularity="1sp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="#FFFFFFFF" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cell_h2"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_width="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/s_h2_time"
                android:layout_weight="1.2"
                android:layout_width="0dp"
                android:layout_height="17dp"
                android:gravity="start|center_vertical"
                android:fontFamily="@font/manrope_600"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="8sp"
                android:autoSizeMaxTextSize="12sp"
                android:autoSizeStepGranularity="1sp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="#FFFFFFFF" />

            <ImageView
                android:id="@+id/wx_h2"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:scaleType="fitCenter"
                android:src="@drawable/wx_clear_day"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/m_h2_temp"
                android:layout_weight="1"
                android:layout_width="0dp"
                android:layout_height="20dp"
                android:gravity="end|center_vertical"
                android:fontFamily="@font/manrope_600"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="9sp"
                android:autoSizeMaxTextSize="14sp"
                android:autoSizeStepGranularity="1sp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="#FFFFFFFF" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cell_h3"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_width="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/s_h3_time"
                android:layout_weight="1.2"
                android:layout_width="0dp"
                android:layout_height="17dp"
                android:gravity="start|center_vertical"
                android:fontFamily="@font/manrope_600"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="8sp"
                android:autoSizeMaxTextSize="12sp"
                android:autoSizeStepGranularity="1sp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="#FFFFFFFF" />

            <ImageView
                android:id="@+id/wx_h3"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:scaleType="fitCenter"
                android:src="@drawable/wx_clear_day"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/m_h3_temp"
                android:layout_weight="1"
                android:layout_width="0dp"
                android:layout_height="20dp"
                android:gravity="end|center_vertical"
                android:fontFamily="@font/manrope_600"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="9sp"
                android:autoSizeMaxTextSize="14sp"
                android:autoSizeStepGranularity="1sp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="#FFFFFFFF" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
