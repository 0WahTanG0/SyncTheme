<?xml version="1.0" encoding="utf-8"?>
<!-- Сгенерировано scripts/gen_widgets.py — не редактировать вручную. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/bg_g"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/wbg_glass"
        android:importantForAccessibility="no" />

    <AnalogClock
        android:id="@+id/analog"
        android:layout_margin="4dp"
        android:dial="@drawable/dial_numbers"
        android:hand_hour="@drawable/analog_hour"
        android:hand_minute="@drawable/analog_minute"
        android:hand_second="@drawable/analog_second"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</FrameLayout>
