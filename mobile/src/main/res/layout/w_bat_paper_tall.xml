<?xml version="1.0" encoding="utf-8"?>
<!-- Сгенерировано scripts/gen_widgets.py — не редактировать вручную. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/bg_g"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/wbg_paper"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:id="@+id/box_v"
        android:paddingHorizontal="12dp"
        android:paddingVertical="16dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:id="@+id/m_pct"
            android:textSize="52dp"
            android:includeFontPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:fontFamily="serif"
            android:maxLines="1"
            android:textColor="#FFFFFFFF" />

        <FrameLayout
            android:id="@+id/box_vbar"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginVertical="10dp"
            android:layout_width="match_parent">

            <ProgressBar
                android:id="@+id/pb_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:indeterminate="false"
                android:max="100"
                android:progress="75"
                android:progressDrawable="@drawable/wbar_vprogress"
                android:layout_width="12dp"
                android:layout_height="match_parent"
                android:layout_gravity="center_horizontal"
                android:minHeight="0dp"
                android:maxHeight="4000dp" />
        </FrameLayout>

        <LinearLayout
            android:layout_height="17sp"
            android:layout_width="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/is_bolt"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/wic_bolt"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/s_state"
                android:layout_weight="1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:fontFamily="serif"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="7sp"
                android:autoSizeMaxTextSize="12sp"
                android:autoSizeStepGranularity="1sp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="#FFFFFFFF" />
        </LinearLayout>

        <TextView
            android:id="@+id/s_remain"
            android:layout_width="match_parent"
            android:layout_height="14sp"
            android:gravity="center"
            android:fontFamily="serif"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="6sp"
            android:autoSizeMaxTextSize="10sp"
            android:autoSizeStepGranularity="1sp"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#FFFFFFFF" />

        <TextView
            android:id="@+id/s_temp"
            android:layout_width="match_parent"
            android:layout_height="14sp"
            android:gravity="center"
            android:fontFamily="serif"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="6sp"
            android:autoSizeMaxTextSize="10sp"
            android:autoSizeStepGranularity="1sp"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#FFFFFFFF" />
    </LinearLayout>
</FrameLayout>
