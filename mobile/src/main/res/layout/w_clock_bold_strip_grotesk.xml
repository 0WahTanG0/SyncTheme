<?xml version="1.0" encoding="utf-8"?>
<!-- Сгенерировано scripts/gen_widgets.py — не редактировать вручную. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/sc_sky28"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/wsc_day_r28"
        android:importantForAccessibility="no" />

    <ImageView
        android:id="@+id/bg_s"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/wbg_r28"
        android:importantForAccessibility="no"
        android:tint="#E61B1B24" />

    <LinearLayout
        android:layout_height="match_parent"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:layout_width="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextClock
            android:id="@+id/m_time"
            android:layout_weight="1.4"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:gravity="center_vertical|start"
            android:format12Hour="hh mm"
            android:format24Hour="HH mm"
            android:fontFamily="@font/manrope_800"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="18sp"
            android:autoSizeMaxTextSize="200sp"
            android:autoSizeStepGranularity="1sp"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#FFFFFFFF" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:layout_marginStart="10dp"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <TextClock
                android:id="@+id/a_weekday"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="start"
                android:format12Hour="EEEE"
                android:format24Hour="EEEE"
                android:fontFamily="@font/onest_600"
                android:textSize="12sp"
                android:textAllCaps="true"
                android:letterSpacing="0.08"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="#FFFFFFFF" />

            <TextClock
                android:id="@+id/m_date"
                android:layout_weight="1"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:gravity="start|center_vertical"
                android:format12Hour="d MMMM"
                android:format24Hour="d MMMM"
                android:fontFamily="@font/oswald_500"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="12sp"
                android:autoSizeMaxTextSize="26sp"
                android:autoSizeStepGranularity="1sp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="#FFFFFFFF" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
