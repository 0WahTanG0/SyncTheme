<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <!-- Поиск часов в Wi‑Fi сети (mDNS) и установка приложения по «Отладке по Wi‑Fi». -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Обновление приложения «поверх» прямо из него самого. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Погода по местоположению и события в виджете календаря (по желанию пользователя). -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <!-- Планшет принимает тему с телефона по Wi‑Fi: служба в фоне, запуск после перезагрузки. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Планшет: попросить систему не усыплять приём темы (иначе в фоне его может закрыть экономия заряда). -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Цифры часов на виджетах — картинкой выбранным шрифтом: её нужно обновлять ровно в начале минуты. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />

    <!-- То же приложение ставится на телевизор (Google TV / Android TV): там нет сенсорного экрана. -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.location" android:required="false" />

    <!-- Виджеты открывают приложения: будильник, календарь, батарею, погоду и выбранные в папке. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SHOW_ALARMS" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="content" android:host="com.android.calendar" />
        </intent>
        <intent>
            <action android:name="android.intent.action.POWER_USAGE_SUMMARY" />
        </intent>
        <intent>
            <action android:name="android.settings.BATTERY_SAVER_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
        </intent>
        <intent>
            <action android:name="android.media.action.STILL_IMAGE_CAMERA" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <package android:name="com.sec.android.daemonapp" />
    </queries>

    <application
        android:name=".mobile.SyncThemeApp"
        android:allowBackup="true"
        android:banner="@drawable/tv_banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SyncTheme">

        <activity
            android:name=".mobile.ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- «Поделиться» из Pinterest, браузера, галереи: картинка или ссылка на неё становится обоями. -->
            <intent-filter android:label="@string/share_target">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter android:label="@string/share_target">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- Часы открывают приложение на телефоне через RemoteActivityHelper. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="synctheme" android:host="phone" />
            </intent-filter>
        </activity>

        <!-- Результат установки циферблата приходит с часов. -->
        <service
            android:name=".mobile.watch.WatchStatusService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:host="*"
                    android:pathPrefix="/synctheme/status"
                    android:scheme="wear" />
            </intent-filter>
        </service>

        <receiver
            android:name=".mobile.update.UpdateReceiver"
            android:exported="false" />

        <!-- Живые обои с часами и эффектом глубины. -->
        <service
            android:name=".mobile.wallpaper.ClockWallpaperService"
            android:exported="true"
            android:label="@string/wallpaper_clock"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/clock_wallpaper" />
        </service>

        <!-- Обои блокировки файлом для системного «Установить как» (адаптивные часы One UI). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <receiver
            android:name=".mobile.widget.ClockWidget"
            android:exported="false"
            android:label="@string/widget_clock">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_clock_info" />
        </receiver>

        <receiver
            android:name=".mobile.widget.DateWidget"
            android:exported="false"
            android:label="@string/widget_date">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_date_info" />
        </receiver>

        <receiver
            android:name=".mobile.widget.CalendarWidget"
            android:exported="false"
            android:label="@string/widget_calendar">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_calendar_info" />
        </receiver>

        <receiver
            android:name=".mobile.widget.WeatherWidget"
            android:exported="false"
            android:label="@string/widget_weather">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_weather_info" />
        </receiver>

        <receiver
            android:name=".mobile.widget.BatteryWidget"
            android:exported="false"
            android:label="@string/widget_battery">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_battery_info" />
        </receiver>

        <receiver
            android:name=".mobile.widget.AppsWidget"
            android:exported="false"
            android:label="@string/widget_apps">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_apps_info" />
        </receiver>

        <!-- Новая минута, смена времени и пояса: перерисовать цифры часов на виджетах. -->
        <receiver
            android:name=".mobile.widget.ClockTickReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Следующий будильник показывается на виджете часов. -->
        <receiver
            android:name=".mobile.widget.AlarmChangedReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.app.action.NEXT_ALARM_CLOCK_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Папка «Приложений»: раскрывается поверх рабочего стола из виджета. -->
        <activity
            android:name=".mobile.widget.FolderActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:noHistory="true"
            android:taskAffinity=".folder"
            android:theme="@style/Theme.SyncTheme.Folder" />

        <!-- Планшет, телевизор, другой телефон: ждёт тему с телефона (пока включён приём). -->
        <service
            android:name=".mobile.link.LinkService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- «Подключить» / «Отклонить» из уведомления о запросе телефона. -->
        <receiver
            android:name=".mobile.link.LinkActionReceiver"
            android:exported="false" />

        <!-- Телевизор: своё окно для пульта на главном экране Google TV. -->
        <activity
            android:name=".mobile.tv.TvActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- «Показать заставку» сразу, не дожидаясь простоя. -->
        <activity
            android:name=".mobile.tv.ThemeShowActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />

        <!-- Заставка в цветах темы: обои и крупные часы (телевизор; на телефоне — при зарядке). -->
        <service
            android:name=".mobile.tv.ThemeDreamService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

        <receiver
            android:name=".mobile.link.LinkBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Своя линия папки: прозрачное окно поверх рабочего стола, рисуется пальцем. -->
        <activity
            android:name=".mobile.widget.FolderDrawActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:taskAffinity=".folderdraw"
            android:theme="@style/Theme.SyncTheme.Folder" />

        <!-- Настройка виджета: при добавлении, по «Настройки» у виджета и из приложения. -->
        <activity
            android:name=".mobile.widget.WidgetConfigActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity=".widgetconfig">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
    </application>
</manifest>
