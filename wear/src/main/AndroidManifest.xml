<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:name="android.hardware.type.watch" />
    <!-- Watch Face Push (Wear OS 6) вызывается только на API 36+, на старых часах работает классический циферблат. -->
    <uses-sdk tools:overrideLibrary="androidx.wear.watchfacepush" />

    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Watch Face Push -->
    <uses-permission android:name="com.google.wear.permission.PUSH_WATCH_FACES" />
    <uses-permission android:name="com.google.wear.permission.SET_PUSHED_WATCH_FACE_AS_ACTIVE" />
    <!-- Классический циферблат (Wear OS 3–5). -->
    <uses-permission android:name="com.google.android.permission.PROVIDE_BACKGROUND" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault">

        <uses-library
            android:name="com.google.android.wearable"
            android:required="false" />
        <!-- Библиотека Wear SDK есть только с Wear OS 6; без неё приложение тоже должно ставиться. -->
        <uses-library
            android:name="wear-sdk"
            android:required="false"
            tools:replace="android:required" />

        <!-- Работает в паре с приложением на телефоне. -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="false" />

        <!-- Циферблат по умолчанию из assets/default_watchface.apk появится в списке циферблатов сразу после установки. -->
        <meta-data
            android:name="com.google.android.wearable.marketplace.DEFAULT_WATCHFACE_VALIDATION_TOKEN"
            android:value="@string/default_wf_token" />

        <activity
            android:name=".wear.MainActivity"
            android:exported="true"
            android:taskAffinity=".main">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Телефон открывает этот экран через RemoteActivityHelper. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="synctheme" android:host="watch" />
            </intent-filter>
        </activity>

        <!-- Классический циферблат для часов без Watch Face Push; на Wear OS 6 выключен. -->
        <service
            android:name=".wear.SyncThemeFaceService"
            android:enabled="@bool/classic_face"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
                <category android:name="com.google.android.wearable.watchface.category.WATCH_FACE" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/watch_face" />
            <meta-data
                android:name="com.google.android.wearable.watchface.preview"
                android:resource="@drawable/face_preview" />
            <meta-data
                android:name="com.google.android.wearable.watchface.preview_circular"
                android:resource="@drawable/face_preview" />
        </service>

        <service
            android:name=".wear.ThemeListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data
                    android:host="*"
                    android:pathPrefix="/synctheme/watchface"
                    android:scheme="wear" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:host="*"
                    android:pathPrefix="/synctheme/ping"
                    android:scheme="wear" />
            </intent-filter>
        </service>
    </application>
</manifest>
